.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data.
#  Refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Visual Studio Code
#  Ignore workspace settings and extension recommendations that may contain
#  local paths or personal preferences not relevant to the project.
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-snippets
.history/

# Amazon Web Services
#  Never commit AWS credentials, session tokens, or account-specific config.
#  Use IAM roles in production and environment variables for local development.
.aws/
aws.json
aws-exports.js
*.pem
*.p12
*.key

# AWS SAM / CDK
.aws-sam/
cdk.out/
cdk.context.json

# AWS Lambda
lambda-package/
layer-package/
*.zip

# Database
#  Exclude local database files, migration artifacts, and connection strings.
*.sql.bak
*.dump
db_backup/
migrations/versions/*.pyc

# Pipeline data
#  Raw and processed documents should not be committed.
#  Use S3 as the source of truth for all pipeline data.
data/raw/
data/processed/
data/output/
logs/
*.log

# Security
#  Prevent accidental commits of credentials, certificates, and secrets.
secrets/
*.secret
*.secrets
*.credentials
credentials.json
service-account.json
token.json
*.p8
*.pfx

# Operating system
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# GitHub
#  Keep workflow files and templates committed.
#  Ignore any auto-generated GitHub artifacts.
.github/ISSUE_TEMPLATE/*.bak
